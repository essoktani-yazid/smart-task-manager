<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smarttask.client.view.controller.projects.ProjectViewController" stylesheets="@../../css/styles.css">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: transparent; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
            <children>

                <Button mnemonicParsing="false" onAction="#onBackToProjects" 
                    styleClass="button-secondary" text="← Back" />
                <Label text="Project Management" styleClass="heading-1" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" promptText="Search..." styleClass="search-field" prefWidth="200"/>
                <Button mnemonicParsing="false" onAction="#onAddTask" styleClass="button-primary" text="+ Task" />
            </children>
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
        </HBox>

        <SplitPane dividerPositions="0.7" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <items>
                <!-- LEFT: TASKS TREE -->
                <VBox spacing="10" style="-fx-padding: 10;">
                    <TreeTableView fx:id="tasksTreeTable" showRoot="false" styleClass="tree-table-view" VBox.vgrow="ALWAYS">
                        <columns>
                            <TreeTableColumn fx:id="colTitle" prefWidth="180.0" text="Task" />
                            <TreeTableColumn fx:id="colStatus" prefWidth="130.0" text="Status" />
                            <TreeTableColumn fx:id="colPriority" prefWidth="100.0" text="Priority" />
                            <TreeTableColumn fx:id="colDueDate" prefWidth="120.0" text="Due Date" />
                            <TreeTableColumn fx:id="colAssignee" prefWidth="120.0" text="Assignee" />
                            <TreeTableColumn fx:id="colActions" prefWidth="200.0" text="Actions" />
                        </columns>
                        <columnResizePolicy>
                            <TreeTableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TreeTableView>
                </VBox>

                <!-- RIGHT: INSPECTOR PANEL -->
                <VBox styleClass="inspector-panel" minWidth="300.0">
                    <children>
                        <!-- Inspector Header -->
                        <HBox alignment="CENTER_LEFT" styleClass="inspector-header">
                            <Label text="Inspector" styleClass="heading-2" />
                            <Region HBox.hgrow="ALWAYS" />
                            <!-- Contextual actions for the selection could go here -->
                        </HBox>

                        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="transparent-pane">
                            <tabs>
                                <Tab text="Details &amp; Files">
                                    <content>
                                        <VBox spacing="15.0" style="-fx-padding: 15; -fx-background-color: white;">
                                            <Label text="Tags" styleClass="heading-2" />
                                            <HBox spacing="5" alignment="CENTER_LEFT">
                                                 <ListView fx:id="tagsList" orientation="HORIZONTAL" prefHeight="40.0" styleClass="list-view" HBox.hgrow="ALWAYS"/>
                                                 <Button onAction="#onAddTag" text="+" styleClass="button-secondary"/>
            
                                            </HBox>
                                            
                                            <Separator />
                                            
                                            <Label text="Comments" styleClass="heading-2" />
                                            <ListView fx:id="commentsList" VBox.vgrow="ALWAYS" styleClass="comments-list" />
                                            <HBox spacing="8.0" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                                                <TextField fx:id="commentField" promptText="Write a comment..." HBox.hgrow="ALWAYS" 
                                                    style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 15;"/>
                                                
                                                <Button fx:id="attachBtn" onAction="#onAttachFileToComment" text="📎" 
                                                    style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-size: 18px; -fx-cursor: hand;">
                                                    <tooltip>
                                                        <Tooltip text="Attach file"/>
                                                    </tooltip>
                                                </Button>
                                                
                                                <Button onAction="#onAddComment" text="Send" styleClass="button-primary"
                                                    style="-fx-background-radius: 20; -fx-padding: 8 20;"/>
                                            </HBox>
                                        </VBox>
                                    </content>
                                </Tab>

                                 <Tab text="Teams">
                                    <content>
                                        <VBox spacing="15.0" style="-fx-padding: 15; -fx-background-color: white;">
                                             <TableView fx:id="teamsTable" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colTeamName" text="Name" />
                                                    <TableColumn fx:id="colTeamDescription" text="Role" />
                                                </columns>
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                </columnResizePolicy>
                                            </TableView>
                                            <HBox spacing="10">
                                                <Button onAction="#onAddTeam" text="Add Team" styleClass="button-secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                                <Button onAction="#onRemoveTeam" text="Remove" styleClass="action-button-delete"/>
                                            </HBox>
                                        </VBox>
                                    </content>
                                </Tab>

                            </tabs>
                        </TabPane>
                    </children>
                </VBox>
            </items>
        </SplitPane>

    </children>
</VBox>