<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smarttask.client.view.controller.projects.ProjectsViewController">
    <top>
        <ToolBar>
            <Button text="Ajouter Projet" onAction="#onAddProject" />
            <Button text="Modifier Projet" onAction="#onEditProject" />
            <Button text="Supprimer Projet" onAction="#onDeleteProject" />
            <Separator />
            <Button text="Ajouter Tâche" onAction="#onAddTask" />
            <Button text="Modifier Tâche" onAction="#onEditTask" />
            <Button text="Supprimer Tâche" onAction="#onDeleteTask" />
        </ToolBar>
    </top>
    <left>
        <VBox spacing="6" prefWidth="260" style="-fx-padding: 8;">
            <HBox spacing="6">
                <Label text="Projets" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="➕" style="-fx-font-size: 11; -fx-padding: 4 8;" onAction="#onAddProject" />
            </HBox>
            <ListView fx:id="projectsList" prefWidth="260" onMouseClicked="#onProjectClicked" style="-fx-control-inner-background: rgba(255,255,255,0.9);" />
        </VBox>
    </left>
    <center>
        <SplitPane dividerPositions="0.6">
            <SplitPane orientation="VERTICAL">
                <TableView fx:id="tasksTable" prefHeight="300" onMouseClicked="#onTaskClicked">
                    <columns>
                        <TableColumn fx:id="colTitle" text="Titre" />
                        <TableColumn fx:id="colStatus" text="Statut" />
                        <TableColumn fx:id="colDueDate" text="Échéance" />
                        <TableColumn fx:id="colPriority" text="Priorité" />
                        <TableColumn fx:id="colAssignee" text="Assigné à" prefWidth="120" />
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="100" />
                    </columns>
                </TableView>
                <VBox spacing="6">
                    <padding>
                        <Insets top="8" right="8" bottom="8" left="8" />
                    </padding>
                    <HBox spacing="6">
                        <Label text="Sous-tâches (Détails)" style="-fx-font-weight: bold; -fx-padding: 10 0 5 0;"/>                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="+" fx:id="addSubtaskBtn" onAction="#onAddSubtask" />
                    </HBox>
                    <TableView fx:id="subTasksTable" VBox.vgrow="ALWAYS" prefHeight="200" onMouseClicked="#onSubtaskClicked">
                        <columns>
                            <TableColumn fx:id="subTitleCol" text="Titre" prefWidth="200"/>
                            <TableColumn fx:id="subStatusCol" text="Statut" prefWidth="100"/>
                            <TableColumn fx:id="subPriorityCol" text="Priorité" prefWidth="100"/>
                            <TableColumn fx:id="subAssigneeCol" text="Assigné à" prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucune sous-tâche sélectionnée"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </SplitPane>
            <ScrollPane fitToWidth="true">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="Détails Tâche" style="-fx-font-weight: bold; -fx-font-size: 14;" />
                    
                    <Separator />
                    <Label text="Tags" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                    <HBox spacing="6">
                        <ListView fx:id="tagsList" prefHeight="80" style="-fx-control-inner-background: rgba(99,102,241,0.05); -fx-border-color: #e0e7ff; -fx-border-radius: 8; -fx-background-radius: 8;" />
                        <VBox spacing="4">
                            <Button text="+" style="-fx-font-size: 12; -fx-padding: 6 12;" onAction="#onAddTag" />
                            <Button text="✕" style="-fx-font-size: 12; -fx-padding: 6 12; -fx-text-fill: #ef4444;" onAction="#onRemoveTag" />
                        </VBox>
                    </HBox>
                    
                    <Separator />
                    <Label text="Commentaires" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                    <ListView fx:id="commentsList" prefHeight="100" style="-fx-control-inner-background: rgba(59,130,246,0.05); -fx-border-color: #bfdbfe; -fx-border-radius: 8; -fx-background-radius: 8;" />
                    <HBox spacing="6">
                        <TextField fx:id="commentField" promptText="Ajouter un commentaire..." HBox.hgrow="ALWAYS" style="-fx-border-radius: 8; -fx-background-radius: 8;" />
                        <Button text="→" style="-fx-font-size: 12; -fx-padding: 8 14;" onAction="#onAddComment" />
                    </HBox>
                    
                    <Separator />
                    <Label text="Suivi du temps" style="-fx-font-weight: bold" />
                    <HBox spacing="6">
                        <Button text="Démarrer" onAction="#onStartTimeTracking" />
                        <Button text="Arrêter" onAction="#onStopTimeTracking" />
                        <Label fx:id="timeTrackingLabel" text="0h 0m" />
                    </HBox>
                    
                    <Separator />
                    <Label text="Options Tâche" style="-fx-font-weight: bold" />
                    <HBox spacing="6">
                        <Button text="Ajouter Dépendance" onAction="#onAddDependency" />
                        <Button text="Partager Tâche" onAction="#onShareTask" />
                    </HBox>
                    <HBox spacing="6">
                        <Button text="Pièce Jointe" onAction="#onAttachFileToComment" />
                        <Button text="Définir Récurrence" onAction="#onSetRecurrence" />
                    </HBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>