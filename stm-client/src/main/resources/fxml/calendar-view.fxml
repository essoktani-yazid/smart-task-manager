<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smarttask.client.view.controller.CalendarController"
            styleClass="calendar-root"
            stylesheets="@../css/calendar.css">

    <!-- Define ToggleGroup -->
    <fx:define>
        <ToggleGroup fx:id="viewToggleGroup"/>
    </fx:define>

    <!-- Header -->
    <top>
        <VBox styleClass="header-container">
            <!-- Top toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="toolbar">
                <padding>
                    <Insets topRightBottomLeft="15"/>
                </padding>

                <!-- App title -->
                <Label text="Calendar" styleClass="app-title">
                    <font>
                        <Font name="System Bold" size="24"/>
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Navigation -->
                <HBox alignment="CENTER" spacing="10" styleClass="navigation">
                    <Button fx:id="prevButton" text="‹" onAction="#handlePrevious" styleClass="nav-button"/>
                    <Button fx:id="todayButton" text="Today" onAction="#handleToday" styleClass="today-button"/>
                    <Button fx:id="nextButton" text="›" onAction="#handleNext" styleClass="nav-button"/>
                </HBox>

                <!-- Current date label -->
                <Label fx:id="currentDateLabel" text="January 2026" styleClass="date-label">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- View toggle buttons -->
                <HBox alignment="CENTER" spacing="0" styleClass="view-toggle-group">
                    <ToggleButton fx:id="dayViewButton" text="Day" toggleGroup="$viewToggleGroup" styleClass="view-toggle, view-toggle-left"/>
                    <ToggleButton fx:id="weekViewButton" text="Week" toggleGroup="$viewToggleGroup" styleClass="view-toggle, view-toggle-middle"/>
                    <ToggleButton fx:id="monthViewButton" text="Month" toggleGroup="$viewToggleGroup" styleClass="view-toggle, view-toggle-middle"/>
                    <ToggleButton fx:id="yearViewButton" text="Year" toggleGroup="$viewToggleGroup" styleClass="view-toggle, view-toggle-right"/>
                </HBox>

                <!-- Add event button -->
                <Button fx:id="addTaskButton" text="📋 Add Task" onAction="#handleAddTask" styleClass="add-task-button"/>
                <Button fx:id="addEventButton" text="+ Add Event" onAction="#handleAddEvent" styleClass="add-event-button"/>
            </HBox>

            <!-- Separator -->
            <Separator/>
        </VBox>
    </top>

    <!-- Main content -->
    <center>
        <HBox>
            <!-- Calendar container -->
            <StackPane fx:id="calendarContainer" HBox.hgrow="ALWAYS" styleClass="calendar-container">
                <padding>
                    <Insets topRightBottomLeft="10"/>
                </padding>
            </StackPane>
        </HBox>
    </center>

    <!-- Right sidebar - Filters and upcoming events -->
    <right>
        <VBox prefWidth="280" spacing="0" styleClass="sidebar">
            <padding>
                <Insets topRightBottomLeft="15"/>
            </padding>

            <!-- Filter section -->
            <VBox spacing="15" styleClass="filter-section">
                <Label text="Filters" styleClass="section-title">
                    <font>
                        <Font name="System Bold" size="16"/>
                    </font>
                </Label>

                <!-- Priority filters -->
                <VBox spacing="8">
                    <Label text="Priority" styleClass="filter-label"/>
                    <VBox spacing="5" styleClass="filter-options">
                        <CheckBox fx:id="filterOptional" text="Optional" selected="true" styleClass="filter-checkbox, priority-optional"/>
                        <CheckBox fx:id="filterStandard" text="Standard" selected="true" styleClass="filter-checkbox, priority-standard"/>
                        <CheckBox fx:id="filterImportant" text="Important" selected="true" styleClass="filter-checkbox, priority-important"/>
                        <CheckBox fx:id="filterUrgent" text="Urgent" selected="true" styleClass="filter-checkbox, priority-urgent"/>
                    </VBox>
                </VBox>
                <!-- Type filters -->
                <VBox spacing="8">
                    <Label text="Item Type" styleClass="filter-label"/>
                    <VBox spacing="5" styleClass="filter-options">
                        <CheckBox fx:id="showTasks" text="📋 Tasks" selected="true" styleClass="filter-checkbox"/>
                        <CheckBox fx:id="showEvents" text="📅 Events" selected="true" styleClass="filter-checkbox"/>
                    </VBox>
                </VBox>

                <!-- Show completed -->
                <VBox spacing="8">
                    <Label text="Display" styleClass="filter-label"/>
                    <CheckBox fx:id="showCompleted" text="Show completed" selected="true" styleClass="filter-checkbox"/>
                </VBox>
            </VBox>

            <Separator>
                <VBox.margin>
                    <Insets top="20" bottom="20"/>
                </VBox.margin>
            </Separator>

            <!-- Upcoming events section -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Upcoming Events" styleClass="section-title">
                    <font>
                        <Font name="System Bold" size="16"/>
                    </font>
                </Label>

                <ListView fx:id="upcomingItemsList" VBox.vgrow="ALWAYS" styleClass="upcoming-list"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>
