<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox fx:id="cardRoot" xmlns="http://javafx.com/javafx/21"
	  xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smarttask.client.view.controller.teams.TeamCardController"
      spacing="18"
      prefWidth="360"
      minWidth="360"
      maxWidth="360"
      alignment="TOP_LEFT"
      styleClass="team-card">

	<HBox spacing="12" alignment="CENTER_LEFT">
		<StackPane styleClass="team-badge">
			<Rectangle fx:id="colorRect"
					   width="40"
					   height="40"
					   arcWidth="8"
					   arcHeight="8"/>
			<SVGPath content="M26.41,18.1a3.28,3.28,0,1,0-3.91,0l-.43.17a8.33,8.33,0,0,0-3.89-2.45,4.41,4.41,0,1,0-4.61,0,8.32,8.32,0,0,0-3.81,2.36l-.24-.1a3.28,3.28,0,1,0-3.93,0A6.06,6.06,0,0,0,1.5,23.8v0a.5.5,0,0,0,.5.5H30a.5.5,0,0,0,.5-.5A6.06,6.06,0,0,0,26.41,18.1ZM22.17,15.5a2.28,2.28,0,1,1,2.28,2.28A2.28,2.28,0,0,1,22.17,15.5Zm2.28,3.28a5,5,0,0,1,5,4.55H24.17a8.26,8.26,0,0,0-1.46-4.23A4.89,4.89,0,0,1,24.45,18.77Zm-12-6.68a3.41,3.41,0,1,1,3.41,3.41A3.41,3.41,0,0,1,12.46,12.09ZM7.55,13.22A2.28,2.28,0,1,1,5.28,15.5,2.28,2.28,0,0,1,7.55,13.22Zm0,5.55A5,5,0,0,1,9.09,19a8.26,8.26,0,0,0-1.52,4.31h-5A5,5,0,0,1,7.55,18.77Zm5.55,4.55H8.57a7.31,7.31,0,0,1,14.59,0H13.1Z"/>
		</StackPane>

		<VBox spacing="4" HBox.hgrow="ALWAYS">
			<Label fx:id="nameLabel"
				   wrapText="true"
				   maxWidth="Infinity"
				   styleClass="team-name"/>
			<Label fx:id="descriptionLabel"
				   wrapText="true"
				   maxWidth="Infinity"
				   styleClass="team-desc"/>
		</VBox>
	</HBox>

    <HBox spacing="6">
		<Button fx:id="btnEditTeam" text="Modifier" styleClass="btn-secondary"
				onAction="#handleEditTeam"/>
		<Button fx:id="btnDeleteTeam" text="Supprimer" styleClass="btn-danger"
				onAction="#handleDeleteTeam"/>
		<Button fx:id="btnViewMembers" text="Membres" styleClass="btn-primary"
				onAction="#handleViewTeam"/>
	</HBox>

</VBox>


