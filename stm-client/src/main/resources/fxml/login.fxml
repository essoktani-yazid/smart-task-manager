<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smarttask.client.view.controller.LoginController">
   <children>
      <Label text="SmartTaskManager" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Label>
      <Label text="Connexion" textFill="#7f8c8d">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <VBox spacing="10.0" styleClass="login-form">
         <children>
            <TextField fx:id="usernameField" promptText="Nom d'utilisateur" />
            <PasswordField fx:id="passwordField" promptText="Mot de passe" />
            <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" text="Se connecter" />
            <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegister" text="S'inscrire" />
            <Label fx:id="errorLabel" textFill="#e74c3c" visible="false" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <stylesheets>
      <URL value="@../css/styles.css" />
   </stylesheets>
</VBox>

