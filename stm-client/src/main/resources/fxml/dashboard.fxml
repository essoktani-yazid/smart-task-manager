<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.smarttask.client.view.controller.DashboardController" 
            styleClass="main-container">

   <center>
      <VBox fx:id="tasksView" spacing="20.0" style="-fx-background-color: #f8f9fa;">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Tableau de Bord" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
                        <Label text="Gérez vos projets et optimisez votre temps avec l'IA." style="-fx-text-fill: #6c757d;" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#handleAddTask" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20;" text="+ Nouvelle Tâche" />
               </children>
            </HBox>

            <TableView fx:id="tasksTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 12; -fx-background-color: white; -fx-border-color: #eef2f7; -fx-border-radius: 12;">
              <columns>
                <TableColumn fx:id="titleColumn" prefWidth="250.0" text="Titre" />
                <TableColumn fx:id="priorityColumn" prefWidth="120.0" text="Priorité" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Statut" />
                <TableColumn fx:id="dueDateColumn" prefWidth="150.0" text="Échéance" />
                <TableColumn fx:id="actionsColumn" prefWidth="150.0" text="Actions" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>