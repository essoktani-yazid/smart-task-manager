<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fitToWidth="true" styleClass="dashboard-scroll" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smarttask.client.view.controller.DashboardController">
    <content>
        <VBox spacing="25.0" styleClass="dashboard-container">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <HBox fx:id="smartHeaderCard" alignment="CENTER_LEFT" spacing="20" styleClass="smart-header-card">
                <padding>
                    <Insets bottom="20" left="30" right="30" top="20" />
                </padding>
                
                <StackPane fx:id="moodContainer" styleClass="mood-indicator-container">
                    <Label fx:id="moodEmojiLabel" style="-fx-font-size: 36px;" text="⏳" />
                </StackPane>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="insightTitleLabel" styleClass="insight-title" text="Connexion à votre coach..." />
                    <Label fx:id="insightMessageLabel" styleClass="insight-message" text="Analyse de vos performances en cours..." wrapText="true" />
                </VBox>

                <Button fx:id="smartActionButton" styleClass="btn-smart-action" text="Optimize Schedule" visible="false">
                    <graphic>
                        <SVGPath content="M7.5 5.6L10 8l4-4M19 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6" style="-fx-fill: white;" />
                    </graphic>
                </Button>
            </HBox>

            <HBox spacing="20">
                <VBox HBox.hgrow="ALWAYS" styleClass="metric-card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="icon-container, icon-purple">
                            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" styleClass="metric-icon" />
                        </StackPane>
                        <Label styleClass="metric-label" text="Productivity Score" />
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <Label fx:id="productivityScoreLabel" styleClass="metric-value" text="0%" />
                    <Label fx:id="productivityTrendLabel" styleClass="metric-trend, trend-neutral" text="..." />
                </VBox>

                <VBox HBox.hgrow="ALWAYS" styleClass="metric-card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="icon-container, icon-blue">
                            <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" styleClass="metric-icon" />
                        </StackPane>
                        <Label styleClass="metric-label" text="Time Tracked" />
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <Label fx:id="timeTrackedLabel" styleClass="metric-value" text="0h 0m" />
                    <Label styleClass="metric-trend, trend-neutral" text="On track for goals" />
                </VBox>

                <VBox HBox.hgrow="ALWAYS" styleClass="metric-card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="icon-container, icon-green">
                            <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" styleClass="metric-icon" />
                        </StackPane>
                        <Label styleClass="metric-label" text="Tasks Done" />
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <Label fx:id="tasksDoneLabel" styleClass="metric-value" text="0" />
                    <Label styleClass="metric-trend, trend-down" text="Analytics Ready" />
                </VBox>
            </HBox>

            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <VBox HBox.hgrow="ALWAYS" styleClass="chart-card">
                    <Label styleClass="chart-title" text="Performance Trends" />
                    <BarChart fx:id="performanceChart" legendVisible="false" verticalGridLinesVisible="false">
                        <xAxis>
                            <CategoryAxis label="Day" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Tasks" />
                        </yAxis>
                    </BarChart>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" styleClass="chart-card">
                    <Label styleClass="chart-title" text="Time Distribution" />
                    <PieChart fx:id="timeDistributionChart" labelsVisible="true" legendSide="BOTTOM" />
                </VBox>
            </HBox>

        </VBox>
    </content>
</ScrollPane>