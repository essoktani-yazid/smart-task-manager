<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.smarttask.client.view.controller.DashboardController" 
            styleClass="main-container">
   
   <left>
      <VBox prefWidth="260.0" styleClass="sidebar-creative" spacing="0.0">
         <children>
            <StackPane styleClass="sidebar-header-creative">
               <children>
                  <VBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="SMART" styleClass="logo-text-top">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Label text="TASK.AI" styleClass="logo-text-main">
                           <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="30.0" left="25.0" right="20.0" top="40.0" />
               </padding>
            </StackPane>
            
            <VBox spacing="12.0" styleClass="nav-menu" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="tasksButton" maxWidth="Infinity" styleClass="nav-button-creative" text="Dashboard" />
                  <Button fx:id="calendarButton" maxWidth="Infinity" styleClass="nav-button-creative" text="Planning" />
                  <Button fx:id="aiButton" maxWidth="Infinity" styleClass="nav-button-creative-special" text="AI Assistant" />
                  <Button fx:id="analyticsButton" maxWidth="Infinity" styleClass="nav-button-creative" text="Insights" />
               </children>
               <padding>
                  <Insets left="15.0" right="15.0" top="20.0" />
               </padding>
            </VBox>
            
            <VBox styleClass="user-profile-card" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <StackPane styleClass="avatar-circle">
                           <Label text="Y" textFill="WHITE" style="-fx-font-weight: bold;" />
                        </StackPane>
                        <VBox>
                           <Label fx:id="userNameLabel" text="Yazid ESSOKTANI" styleClass="user-name" />
                           <Label text="Premium AI User" styleClass="user-role" />
                        </VBox>
                     </children>
                  </HBox>
                  <Button fx:id="logoutButton" maxWidth="Infinity" onAction="#handleLogout" styleClass="logout-button-creative" text="Sign Out" />
               </children>
               <padding>
                  <Insets bottom="25.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </left>

   <center>
      <VBox spacing="20.0" style="-fx-background-color: #f8f9fa;">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Tableau de Bord" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #212529;" />
                        <Label text="Gérez vos projets et optimisez votre temps avec l'IA." style="-fx-text-fill: #6c757d;" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#handleAddTask" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20;" text="+ Nouvelle Tâche" />
               </children>
            </HBox>

            <TableView fx:id="taskTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 12; -fx-background-color: white; -fx-border-color: #eef2f7; -fx-border-radius: 12;">
              <columns>
                <TableColumn fx:id="titleColumn" prefWidth="250.0" text="Titre" />
                <TableColumn fx:id="priorityColumn" prefWidth="120.0" text="Priorité" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Statut" />
                <TableColumn fx:id="dueDateColumn" prefWidth="150.0" text="Échéance" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>