<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smarttask.client.view.controller.MainLayoutController" styleClass="main-container">
   <left>
      <VBox prefWidth="260.0" styleClass="sidebar-creative" spacing="0.0">
         <children>
            <StackPane styleClass="sidebar-header-creative">
               <children>
                  <VBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="SMART" textFill="WHITE" styleClass="logo-text-top">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Label text="TASK.AI" textFill="WHITE" styleClass="logo-text-main">
                           <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="30.0" left="25.0" right="20.0" top="40.0" />
               </padding>
            </StackPane>
            
            <VBox spacing="12.0" styleClass="nav-menu" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="tasksButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#showTasks" styleClass="nav-button-creative" text="📋  Dashboard" />
                  <Button fx:id="calendarButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#showCalendar" styleClass="nav-button-creative" text="📅  Planning" />
                  <Button fx:id="aiButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#showAI" styleClass="nav-button-creative-special" text="🤖  AI Assistant" />
                  <Button fx:id="collaborationButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#showCollaboration" styleClass="nav-button-creative" text="👥  Teamwork" />
                  <Button fx:id="analyticsButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#showAnalytics" styleClass="nav-button-creative" text="📊  Insights" />
               </children>
               <padding>
                  <Insets left="15.0" right="15.0" top="20.0" />
               </padding>
            </VBox>
            
            <VBox styleClass="user-profile-card" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <StackPane styleClass="avatar-circle">
                           <Label text="Y" textFill="WHITE" />
                        </StackPane>
                        <VBox>
                           <Label fx:id="userLabel" text="Yazid ESSOKTANI" styleClass="user-name" />
                           <Label text="Premium AI User" styleClass="user-role" />
                        </VBox>
                     </children>
                  </HBox>
                  <Button fx:id="logoutButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogout" styleClass="logout-button-creative" text="Sign Out" />
               </children>
               <padding>
                  <Insets bottom="25.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentPane" styleClass="center-content-area" />
   </center>
</BorderPane>